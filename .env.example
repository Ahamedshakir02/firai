# Database
POSTGRES_USER=firai
POSTGRES_PASSWORD=firai_secret
POSTGRES_DB=firai_db
DATABASE_URL=postgresql+asyncpg://firai:firai_secret@db:5432/firai_db

# AI Engine — No API keys needed! FirAI uses its own custom AI.
# GEMINI_API_KEY is no longer required.

# Translation (optional — only needed for Malayalam ↔ English translation)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here

# Google Maps (optional — reserved for future use)
GOOGLE_MAPS_API_KEY=your_maps_api_key_here
