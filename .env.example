# ──────────────────────────────────────────
# FirAI Environment Configuration
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Database — leave unchanged when running with Docker Compose
POSTGRES_USER=firai
POSTGRES_PASSWORD=firai_secret
POSTGRES_DB=firai_db
DATABASE_URL=postgresql+asyncpg://firai:firai_secret@db:5432/firai_db

# ──────────────────────────────────────────
# Claude API — optional
# Enables AI-powered conversational legal answers in the Legal Assistant.
# Without this, legal queries are answered from the built-in IPC/BNS knowledge base.
# Get your key at: https://console.anthropic.com
# ──────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────────────────────
# Bhashini — optional
# Required only for Malayalam ↔ English translation.
# Register at: https://bhashini.gov.in/ulca/user-profile
# ──────────────────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Google Maps — optional, reserved for future use
GOOGLE_MAPS_API_KEY=
